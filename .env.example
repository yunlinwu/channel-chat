# Generation (Claude). Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Embeddings (Voyage). Get one at https://dashboard.voyageai.com
VOYAGE_API_KEY=pa-...

# Optional overrides
VOYAGE_MODEL=voyage-4-lite
ANSWER_MODEL=claude-haiku-5-5

# Crude abuse ceiling so a public URL can't drain your API credit.
MAX_ASKS_PER_IP_PER_DAY=20
MAX_ASKS_GLOBAL_PER_DAY=300
